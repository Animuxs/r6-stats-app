# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Dissect replay files
/*.rec
# Dissect output files
/*.json
/*.xlsx
/*.bin
/*.txt
# Memory dumps
/*.dmp

# IDEs
.vscode/launch.json

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# GoLand
.idea

# Dependency directories (remove the comment below to include it)
# vendor/
/web/node_modules/
/web/dist/
/web/tsconfig.tsbuildinfo

# Match replays loaded by scripts/app.py
/replays/
/.streamlit/app.log
# Season stats database (scripts/season_stats.py)
/data/
# Python
__pycache__/
*.pyc
/.venv/

# Windows app build (desktop/build.ps1)
/build/
/dist/

# the browser edition's build output (python browser/build.py)
/browser/dist/
/browser/r6-dissect.wasm
/browser/wasm_exec.js

# coverage data (scripts/run_tests.py --coverage writes it to build/)
.coverage
.coverage.*

# Local Cloudflare development state contains team credentials and data
/team-server/.wrangler/
/team-server/node_modules/
/team-server/.dev.vars
